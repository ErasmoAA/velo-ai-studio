            <span class="related-card-tag">{{ p.tag_es }}</span>
            <span class="related-card-title">{{ p.title_es }}</span>
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {# Comments — Cusdis embed (reemplaza APP_ID con tu ID de cusdis.com) #}
      <div class="comments">
        <p class="comments-title">// Comentarios</p>
        <div id="cusdis_thread"
