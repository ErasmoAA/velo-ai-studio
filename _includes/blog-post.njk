            <span class="related-card-title">{{ p.data.title_en }}</span>
          </a>
          {% endfor %}
          {% for p in relatedOld %}
          <a href="/blog/{{ p.slug }}.html" class="related-card">
            <span class="related-card-emoji">{{ p.emoji }}</span>
            <span class="related-card-tag">{{ p.tag_en }}</span>
            <span class="related-card-title">{{ p.title_en }}</span>
          </a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      {# Comments — Cusdis embed #}
      <div class="comments">
        <p class="comments-title">// Comments</p>
        <div id="cusdis_thread"
          data-host="https://cusdis.com"
          data-app-id="3f5dadf1-cfda-4705-af51-198b5937e093"
          data-page-id="{{ slug }}"
          data-page-url="https://veloaistudio.online/blog/{{ slug }}.html"
          data-page-title="{{ title_en }}"
          data-lang="en">
        </div>
        <script async defer src="https://cusdis.com/js/cusdis.es.js"></script>
      </div>

      <footer>
        <p style="margin-bottom:10px;">© 2026 Velo AI Studio</p>
        <div>
          <a href="/">Home</a> |
          <a href="/studio.html">Studio</a> |
          <a href="/blog/">Blog</a> |
          <a href="/about.html">About</a> |
          <a href="/editorial.html">Methodology</a> |
          <a href="/contact.html">Contact</a> |
          <a href="/privacy.html">Privacy</a> |
          <a href="/tos.html">Terms</a>
        </div>
      </footer>
    </div>

  </div>

  <script>
  (function () {
    var isEN = !navigator.language.toLowerCase().startsWith('es');
    if (isEN) {
      document.documentElement.lang = 'en';
      document.title = '{{ title_en }} — Blog Velo AI Studio';
      var md = document.querySelector('meta[name="description"]');
      if (md) md.setAttribute('content', '{{ desc_en }}');
      var ogTitle = document.querySelector('meta[property="og:title"]');
      if (ogTitle) ogTitle.setAttribute('content', '{{ title_en }} — Blog Velo AI Studio');
      var ogDesc = document.querySelector('meta[property="og:description"]');
      if (ogDesc) ogDesc.setAttribute('content', '{{ desc_en }}');
      document.querySelectorAll('.lang-es').forEach(function (e) { e.style.display = 'none'; });
      document.querySelectorAll('.lang-en').forEach(function (e) { e.style.display = 'block'; });
    }
  })();
  </script>

  <!-- COOKIE CONSENT BANNER -->
  <div id="cookieConsent" style="display:none; position:fixed; bottom:0; left:0; right:0; z-index:99999; background:var(--surface); border-top:2px solid var(--accent); padding:18px 24px; font-family:'Space Mono',monospace; font-size:0.75rem; color:var(--text); box-shadow:0 -4px 24px rgba(0,0,0,0.3);">
    <div style="max-width:960px; margin:0 auto; display:flex; flex-wrap:wrap; align-items:center; gap:14px; justify-content:space-between;">
      <p class="cc-text-es" style="flex:1; min-width:240px; line-height:1.6; margin:0; color:var(--prose);">
        Este sitio usa cookies propias y de terceros (Google AdSense, Google Analytics) para mostrar anuncios personalizados y analizar el tráfico.
        Al hacer clic en <strong>"Aceptar"</strong>, consientes el uso de cookies.
        <a href="/privacy.html" style="color:var(--accent2);">Política de Privacidad</a>.
      </p>
      <p class="cc-text-en" style="flex:1; min-width:240px; line-height:1.6; margin:0; color:var(--prose); display:none;">
        This site uses first-party and third-party cookies (Google AdSense, Google Analytics) to show personalized ads and analyze traffic.
        By clicking <strong>"Accept"</strong>, you consent to the use of cookies.
        <a href="/privacy.html" style="color:var(--accent2);">Privacy Policy</a>.
      </p>
      <div style="display:flex; gap:10px; flex-shrink:0;">
        <button onclick="acceptCookies()" style="padding:10px 22px; background:linear-gradient(135deg,var(--accent),var(--accent2)); border:none; border-radius:8px; color:white; font-family:'Syne',sans-serif; font-weight:700; font-size:0.82rem; cursor:pointer;" class="cc-btn-accept">Aceptar</button>
        <button onclick="rejectCookies()" style="padding:10px 22px; background:var(--surface2); border:1px solid var(--border); border-radius:8px; color:var(--muted); font-family:'Syne',sans-serif; font-weight:600; font-size:0.82rem; cursor:pointer;" class="cc-btn-reject">Rechazar</button>
      </div>
    </div>
  </div>
  <script>
  (function(){
    var isEN = document.documentElement.lang === 'en';
    if (isEN) {
      var es = document.querySelector('.cc-text-es'); if (es) es.style.display='none';
      var en = document.querySelector('.cc-text-en'); if (en) en.style.display='block';
      var a = document.querySelector('.cc-btn-accept'); if (a) a.textContent='Accept';
      var r = document.querySelector('.cc-btn-reject'); if (r) r.textContent='Reject';
    }
    if (!localStorage.getItem('cookieConsent')) {
      var el = document.getElementById('cookieConsent'); if (el) el.style.display='block';
    }
  })();
  function acceptCookies(){localStorage.setItem('cookieConsent','accepted');document.getElementById('cookieConsent').style.display='none';}
  function rejectCookies(){localStorage.setItem('cookieConsent','rejected');document.getElementById('cookieConsent').style.display='none';}
  </script>
</body>
</html>
