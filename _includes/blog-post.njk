  <link rel="alternate" hreflang="es" href="https://veloaistudio.online/blog/{{ slug }}.html" />
  <link rel="alternate" hreflang="en" href="https://veloaistudio.online/blog/{{ slug }}.html" />
  <link rel="alternate" hreflang="x-default" href="https://veloaistudio.online/blog/{{ slug }}.html" />
  <meta property="og:type" content="article">
  <meta property="og:url" content="https://veloaistudio.online/blog/{{ slug }}.html">
  <meta property="og:title" content="{{ title_es }} — Blog Velo AI Studio">
  <meta property="og:description" content="{{ desc_es }}">
  <meta property="og:image" content="https://veloaistudio.online/og-image.png">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ title_en }}",
    "description": "{{ desc_en }}",
    "datePublished": "{{ date | isoDate }}",
    "dateModified": "{{ date | isoDate }}",
    "author": {
      "@type": "Person",
      "@id": "https://veloaistudio.online/about.html#person",
      "name": "Ali A.",
