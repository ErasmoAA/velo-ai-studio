  <style>
    @import url('https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;800&display=swap');
    *{margin:0;padding:0;box-sizing:border-box;}
    body{background:var(--bg);color:var(--text);font-family:'Syne',sans-serif;min-height:100vh;line-height:1.7;}
    body::before{content:'';position:fixed;inset:0;pointer-events:none;z-index:0;
      background:radial-gradient(ellipse 80% 50% at 20% 10%,rgba(124,58,237,0.1) 0%,transparent 60%);}
    .container{max-width:760px;margin:0 auto;padding:40px 24px;position:relative;z-index:1;}

    /* ── Nav ── */
    .nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:48px;}
    .nav a{color:var(--accent2);text-decoration:none;font-family:'Space Mono',monospace;font-size:0.78rem;}
    .nav a:hover{text-decoration:underline;}

    /* ── Top app banner ── */
    .app-top-banner{
      background:linear-gradient(135deg,rgba(124,58,237,0.12),rgba(6,182,212,0.1));
      border:1px solid rgba(124,58,237,0.25);border-radius:12px;
      padding:14px 20px;margin-bottom:40px;
      display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;
    }
    .app-top-banner p{font-family:'Space Mono',monospace;font-size:0.72rem;color:var(--muted);margin:0;}
    .app-top-banner strong{color:var(--text);}
    .banner-btn{
      flex-shrink:0;padding:8px 18px;background:linear-gradient(135deg,var(--accent),var(--accent2));
      border-radius:8px;color:#fff;text-decoration:none;font-family:'Space Mono',monospace;
      font-size:0.7rem;font-weight:700;white-space:nowrap;transition:opacity 0.2s;
    }
    .banner-btn:hover{opacity:0.85;}

    /* ── Article header ── */
    .tag{display:inline-block;background:rgba(6,182,212,0.12);border:1px solid rgba(6,182,212,0.25);
      color:var(--accent2);font-family:'Space Mono',monospace;font-size:0.62rem;text-transform:uppercase;
      letter-spacing:1.5px;padding:3px 10px;border-radius:20px;margin-bottom:16px;}
    h1{font-size:clamp(1.6rem,4vw,2.4rem);font-weight:800;line-height:1.2;margin-bottom:16px;}
    .meta{font-family:'Space Mono',monospace;font-size:0.7rem;color:var(--muted);margin-bottom:40px;}

    /* ── Article body ── */
    h2{font-size:1.2rem;font-weight:700;margin:36px 0 12px;color:var(--text);}
    h3{font-size:1rem;font-weight:700;margin:28px 0 10px;color:var(--accent2);}
    p{color:var(--prose);margin-bottom:18px;font-size:0.95rem;}
    ul,ol{color:var(--prose);font-size:0.95rem;padding-left:24px;margin-bottom:18px;}
    li{margin-bottom:8px;}
    strong{color:var(--text);}
    a{color:var(--accent2);text-decoration:none;}
    a:hover{text-decoration:underline;}
    blockquote{
      background:var(--surface);border-left:3px solid var(--accent2);border-radius:0 8px 8px 0;
      padding:16px 20px;margin:24px 0;font-family:'Space Mono',monospace;font-size:0.82rem;color:var(--accent2);
    }
    code{font-family:'Space Mono',monospace;font-size:0.85em;background:var(--surface2);
      padding:2px 6px;border-radius:4px;color:var(--accent2);}
    pre{background:var(--surface2);border:1px solid var(--border);border-radius:8px;
      padding:16px;overflow-x:auto;margin:20px 0;}
    pre code{background:none;padding:0;}
    img{max-width:100%;border-radius:8px;margin:16px 0;}
    hr{border:none;border-top:1px solid var(--border);margin:36px 0;}

    /* ── AdSense wrapper ── */
    .ad-unit{
      margin:36px 0;padding:8px 0;
      border-top:1px solid var(--border);
      border-bottom:1px solid var(--border);
      text-align:center;min-height:90px;
    }
    .ad-label{
      font-family:'Space Mono',monospace;font-size:0.58rem;
      color:var(--muted);letter-spacing:1px;text-transform:uppercase;
      margin-bottom:6px;display:block;
    }

    /* ── Mid-article CTA ── */
    .mid-cta{
      background:var(--surface);border:1px solid var(--border);border-radius:14px;
      padding:24px;margin:40px 0;display:flex;align-items:center;gap:20px;flex-wrap:wrap;
    }
    .mid-cta-icon{font-size:2rem;flex-shrink:0;}
    .mid-cta-text p{font-size:0.85rem;color:var(--muted);margin:0 0 8px;}
    .mid-cta-text strong{color:var(--text);display:block;font-size:0.95rem;margin-bottom:4px;}
    .mid-cta-btn{
      flex-shrink:0;padding:10px 22px;background:linear-gradient(135deg,var(--accent),var(--accent2));
      border-radius:8px;color:#fff;text-decoration:none;font-weight:700;font-size:0.85rem;
      font-family:'Syne',sans-serif;transition:opacity 0.2s;
    }
    .mid-cta-btn:hover{opacity:0.88;text-decoration:none;}

    /* ── End-of-article CTA ── */
    .end-cta{
      margin-top:56px;padding:36px;
      background:linear-gradient(135deg,rgba(124,58,237,0.15),rgba(6,182,212,0.1));
      border:1px solid rgba(124,58,237,0.3);border-radius:20px;text-align:center;
    }
    .end-cta h3{font-size:1.3rem;font-weight:800;margin-bottom:10px;}
    .end-cta p{color:var(--muted);font-size:0.88rem;margin-bottom:24px;}
    .end-cta-btn{
      display:inline-block;padding:14px 36px;
      background:linear-gradient(135deg,var(--accent),var(--accent2));
      border-radius:10px;color:#fff;text-decoration:none;font-weight:700;font-size:0.95rem;
      font-family:'Syne',sans-serif;transition:opacity 0.2s;
    }
    .end-cta-btn:hover{opacity:0.88;text-decoration:none;}
    .end-cta-note{display:block;margin-top:12px;font-family:'Space Mono',monospace;
      font-size:0.65rem;color:var(--muted);}

    /* ── Author box ── */
    .author-box{
      display:flex;align-items:center;gap:18px;
      background:var(--surface);border:1px solid var(--border);border-radius:14px;
      padding:20px;margin:48px 0 32px;
    }
    .author-avatar{
      width:64px;height:64px;border-radius:50%;flex-shrink:0;
      background:linear-gradient(135deg,var(--accent),var(--accent2));
      display:flex;align-items:center;justify-content:center;
      color:#fff;font-family:'Syne',sans-serif;font-weight:800;font-size:1.6rem;
      box-shadow:0 4px 16px rgba(124,58,237,0.25);
    }
    .author-meta{flex:1;}
    .author-meta .author-role{
      font-family:'Space Mono',monospace;font-size:0.62rem;color:var(--accent2);
      text-transform:uppercase;letter-spacing:1.5px;margin-bottom:3px;
    }
    .author-meta .author-name{font-size:1rem;font-weight:700;color:var(--text);margin-bottom:6px;}
    .author-meta .author-bio{font-size:0.82rem;color:var(--muted);line-height:1.55;margin-bottom:8px;}
    .author-meta .author-links a{
      font-family:'Space Mono',monospace;font-size:0.7rem;
      color:var(--accent2);text-decoration:none;margin-right:14px;
    }
    .author-meta .author-links a:hover{text-decoration:underline;}
    .ai-disclosure{
      background:rgba(245,158,11,0.06);border-left:3px solid var(--accent3);
      border-radius:0 8px 8px 0;padding:12px 16px;margin:0 0 32px;
      font-family:'Space Mono',monospace;font-size:0.7rem;color:var(--muted);line-height:1.55;
    }
    .ai-disclosure strong{color:var(--accent3);}
    @media(max-width:540px){
      .author-box{flex-direction:column;text-align:center;}
    }

    /* ── Related posts ── */
    .related{margin-top:56px;}
    .related-title{
      font-family:'Space Mono',monospace;font-size:0.65rem;text-transform:uppercase;
      letter-spacing:2px;color:var(--muted);margin-bottom:20px;
    }
    .related-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;}
    .related-card{
      background:var(--surface);border:1px solid var(--border);border-radius:12px;
      padding:18px;text-decoration:none;display:block;transition:border-color 0.2s,transform 0.2s;
    }
    .related-card:hover{border-color:var(--accent);transform:translateY(-2px);text-decoration:none;}
    .related-card-emoji{font-size:1.5rem;margin-bottom:8px;display:block;}
    .related-card-tag{
      font-family:'Space Mono',monospace;font-size:0.55rem;text-transform:uppercase;
      letter-spacing:1px;color:var(--accent2);margin-bottom:6px;display:block;
    }
    .related-card-title{font-size:0.82rem;font-weight:700;color:var(--text);line-height:1.35;}

    /* ── Comments section ── */
    .comments{
      margin-top:48px;padding-top:32px;
      border-top:1px solid var(--border);
    }
    .comments-title{
      font-family:'Space Mono',monospace;font-size:0.65rem;text-transform:uppercase;
      letter-spacing:2px;color:var(--muted);margin-bottom:20px;
    }

    /* ── Footer ── */
    footer{margin-top:64px;padding-top:24px;border-top:1px solid var(--border);
      text-align:center;font-family:'Space Mono',monospace;font-size:0.68rem;color:var(--muted);}
    footer a{color:var(--muted);text-decoration:none;margin:0 8px;}
    footer a:hover{color:var(--accent2);}

    .lang-en{display:none;}

    @media(max-width:600px){
      .mid-cta{flex-direction:column;align-items:flex-start;}
      .app-top-banner{flex-direction:column;align-items:flex-start;gap:10px;}
      .related-grid{grid-template-columns:1fr;}
    }
  </style>
  <meta name="monetag" content="7ca439aa8317b6517fa50ba436d45a8f">
</head>
<body>
  <div class="container">
