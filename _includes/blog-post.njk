            <a href="mailto:contacto@veloaistudio.online">Contacto</a>
          </div>
        </div>
      </div>

      {# AI disclosure #}
      <p class="ai-disclosure">
        <strong>Transparencia:</strong> este artículo fue redactado con asistencia de modelos de lenguaje (GPT-5 / Claude) para su estructura inicial, y posteriormente revisado, verificado técnicamente y editado manualmente por el autor antes de publicarse. Lee el <a href="/editorial.html" style="color:var(--accent2);">protocolo editorial completo</a>.
      </p>

      {# Related posts #}
      {% if relatedNew.length > 0 or relatedOld.length > 0 %}
      <div class="related">
        <p class="related-title">// También te puede interesar</p>
        <div class="related-grid">
          {% for p in relatedNew %}
          <a href="/blog/{{ p.data.slug }}.html" class="related-card">
